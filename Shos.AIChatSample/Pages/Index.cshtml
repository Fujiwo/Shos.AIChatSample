@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container">
    <div class="row p-1">
        <div class="col-8">
            <div id="messagesList" class="talk1">
                @foreach (var message in Model.Messages) {
                    <partial name="_MessagePartial" model="message" />
                }
            </div>
        </div>
    </div>
    <div class="row p-1">
        <div class="col-8">
            <hr />
        </div>
    </div>
    <div class="row p-1">
        <div class="col-2">Message</div>
        <div class="col-6"><input type="text" class="w-100" id="messageInput" maxlength="@FCAIChat.Hubs.ChatHub.MaxPromptLength" placeholder="@@Agent で AI に質問できます" /></div>
    </div>
    <div class="row p-1">
        <div class="col-8 text-end">
            <input type="button" id="sendButton" value="Send Message" />
            <input type="button" id="clearButton" value="Clear" />
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
